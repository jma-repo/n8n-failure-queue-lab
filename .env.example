# `uv run lab init` copies this to .env and fills the secrets with random values. .env is git-ignored.
N8N_ENCRYPTION_KEY=replace-me
LAB_API_TOKEN=replace-me
N8N_OWNER_EMAIL=owner@lab.test
N8N_OWNER_PASSWORD=Replace-me-1

# "live" points the workflows at the real Bank of Canada Valet API instead of the local stand-in
LAB_SOURCE=sim
